<UserControl x:Class="BIS.ERP.Views.Configurator.ModuleManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Модули" FontSize="16" FontWeight="SemiBold" Margin="4,2,0,10"/>
                <ListBox x:Name="ModulesList" Grid.Row="1" DisplayMemberPath="DisplayName" SelectionChanged="OnModuleSelected"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Добавить" Width="105" Height="34" Click="OnAddClick"
                            Background="#27AE60" Foreground="White"/>
                    <Button x:Name="DeleteButton" Content="Удалить" Width="95" Height="34" Margin="8,0,0,0"
                            Click="OnDeleteClick" Background="#C0392B" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="14"/><ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Наименование" Margin="0,0,0,5"/>
                        <TextBox x:Name="NameBox" Height="35" Padding="8,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Код" Margin="0,0,0,5"/>
                        <TextBox x:Name="CodeBox" Height="35" Padding="8,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Иконка" Margin="0,0,0,5"/>
                        <TextBox x:Name="IconBox" Height="35" Padding="8,4"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Описание" Margin="0,0,0,5"/>
                        <TextBox x:Name="DescriptionBox" Height="58" Padding="8" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Порядок" Margin="0,0,0,5"/>
                        <TextBox x:Name="OrderBox" Height="35" Padding="8,4"/>
                    </StackPanel>
                    <CheckBox x:Name="IsActiveCheck" Grid.Column="2" Content="Доступен в инфобазе"
                              VerticalAlignment="Center" Margin="15,15,0,0" IsChecked="True"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Порядок закрытия" Margin="0,0,0,5"/>
                        <TextBox x:Name="CloseOrderBox" Height="35" Padding="8,4"/>
                    </StackPanel>
                    <CheckBox x:Name="ParticipatesInPeriodCloseCheck" Grid.Column="3"
                              Content="Участвует в закрытии периода"
                              VerticalAlignment="Center" Margin="0,18,0,0" IsChecked="True"/>
                    <CheckBox x:Name="RequirePreviousModulesClosedCheck" Grid.Column="5"
                              Content="Закрывать только после предыдущих модулей"
                              VerticalAlignment="Center" Margin="0,18,0,0"/>
                </Grid>

                <TabControl Grid.Row="3">
                    <TabItem Header="Документы">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="SelectAllDocumentsCheck" Content="Выделить все" Margin="4,2,0,6"
                                      Checked="OnSelectAllDocumentsChanged" Unchecked="OnSelectAllDocumentsChanged"/>

                            <TextBlock x:Name="DocumentsEmptyText" Grid.Row="1" Margin="8,14,0,0"
                                       Text="В данный момент в модуле нет документов."
                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       Visibility="Collapsed"/>

                            <DataGrid x:Name="DocumentsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="В модуле" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                    <DataGridTextColumn Header="Документ" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Отчеты">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="SelectAllReportsCheck" Content="Выделить все" Margin="4,2,0,6"
                                      Checked="OnSelectAllReportsChanged" Unchecked="OnSelectAllReportsChanged"/>

                            <TextBlock x:Name="ReportsEmptyText" Grid.Row="1" Margin="8,14,0,0"
                                       Text="В данный момент в модуле нет отчетов."
                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       Visibility="Collapsed"/>

                            <DataGrid x:Name="ReportsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="В модуле" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                    <DataGridTextColumn Header="Отчет" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Неназначенные">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="4,2,0,6">
                                <CheckBox x:Name="SelectAllUnassignedCheck" Content="Выделить все" VerticalAlignment="Center"
                                          Checked="OnSelectAllUnassignedChanged" Unchecked="OnSelectAllUnassignedChanged"/>
                                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                           Text="Объекты без модуля. Отметьте и сохраните — они попадут в этот модуль."/>
                            </StackPanel>

                            <TextBlock x:Name="UnassignedEmptyText" Grid.Row="1" Margin="8,14,0,0"
                                       Text="Неназначенных объектов нет."
                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       Visibility="Collapsed"/>

                            <DataGrid x:Name="UnassignedGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="В модуле" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Объект" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    <Button Content="Сохранить модуль" Width="150" Height="38" HorizontalAlignment="Right"
                            Click="OnSaveClick" Background="{DynamicResource AppAccentBrush}" Foreground="White"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
