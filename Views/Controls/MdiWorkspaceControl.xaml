<UserControl x:Class="BIS.ERP.Views.Controls.MdiWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BIS.ERP.Views.Controls">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="MdiHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#EDF6FF" Offset="0.55"/>
            <GradientStop Color="#E7F0F8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MdiSelectedTabBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1F6FA8" Offset="0"/>
            <GradientStop Color="#25425F" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="MdiToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E9F1F7"/>
            <Setter Property="BorderBrush" Value="#BFD0DF"/>
            <Setter Property="Foreground" Value="#1F3449"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MdiCloseTabButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#2B4156"/>
            <Setter Property="Background" Value="#F7FAFD"/>
            <Setter Property="BorderBrush" Value="#C9D8E6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9,9,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource MdiSelectedTabBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#1F6FA8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6FA9D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#EEF3F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource MdiHeaderBrush}"
                BorderBrush="#CAD8E6"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Закрыть"
                            Style="{StaticResource MdiToolbarButtonStyle}"
                            Click="OnCloseCurrentClick"/>
                    <Button Content="Закрыть все"
                            Style="{StaticResource MdiToolbarButtonStyle}"
                            Click="OnCloseAllClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1AAE8A" Offset="0"/>
                                <GradientStop Color="#2F80C3" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="□" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Открытые окна"
                                   FontWeight="Bold"
                                   Foreground="#1F3449"/>
                        <TextBlock Text="Рабочие формы открываются во вкладках"
                                   FontSize="11"
                                   Foreground="#63798C"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="EmptyState"
                    Background="#FFFFFF"
                    BorderBrush="#D8E1EA"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Выберите раздел слева"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#23384D"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Окна будут открываться здесь как вкладки."
                               Margin="0,8,0,0"
                               Foreground="#66788A"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TabControl x:Name="DocumentsTabControl"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Documents, RelativeSource={RelativeSource AncestorType={x:Type controls:MdiWorkspaceControl}}}"
                        SelectedItem="{Binding SelectedDocument, RelativeSource={RelativeSource AncestorType={x:Type controls:MdiWorkspaceControl}}, Mode=TwoWay}"
                        Visibility="Collapsed">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" MinWidth="128">
                            <Button DockPanel.Dock="Right"
                                    Content="x"
                                    Tag="{Binding}"
                                    Style="{StaticResource MdiCloseTabButtonStyle}"
                                    Click="OnCloseTabClick"
                                    ToolTip="Закрыть окно"/>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF"
                                BorderBrush="#C9D8E6"
                                BorderThickness="1"
                                CornerRadius="0,12,12,12"
                                Padding="10">
                            <ContentPresenter Content="{Binding Content}"/>
                        </Border>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>