<UserControl x:Class="BIS.ERP.Views.CashOrderWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock x:Name="DescriptionText" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- Панель фильтров и действий -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Border Margin="0,0,0,8" Padding="10,8" BorderBrush="#D5DEE8" BorderThickness="1" Background="#F8FBFE" CornerRadius="5">
                <WrapPanel>
                    <TextBlock Text="Поиск и отбор:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="PeriodStartDatePicker" Width="120" SelectedDateChanged="OnFilterChanged"/>
                    <TextBlock Text="по:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <DatePicker x:Name="PeriodEndDatePicker" Width="120" SelectedDateChanged="OnFilterChanged"/>
                    <TextBlock Text="Касса:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="Bold"/>
                    <ComboBox x:Name="CashDeskFilterCombo"
                              Width="260"
                              Height="30"
                              DisplayMemberPath="DisplayNameWithAccount"
                              SelectionChanged="OnFilterChanged"/>
                    <Button x:Name="CashPostingsButton" Content="Проводки по кассе" Width="145" Height="32" Margin="10,0,0,0"
                            Background="#16A085" Foreground="White" Click="OnCashPostingsClick"/>
                    <Button x:Name="RefreshButton" Content="Обновить" Width="100" Height="32" Margin="10,0,0,0"
                            Background="#95A5A6" Foreground="White" Click="OnRefreshClick"/>
                </WrapPanel>
            </Border>
            <Border Margin="0,0,0,8" Padding="6" BorderBrush="#D5DEE8" BorderThickness="1" Background="#F6FAFD" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="8,6" BorderBrush="#CFEBD8" BorderThickness="1" Background="#F7FFF9" CornerRadius="4">
                        <StackPanel>
                            <TextBlock x:Name="OpenCashDayHintText" Text="Текущий открытый день: выберите конкретную кассу" FontWeight="SemiBold" Foreground="#1D6F42" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,5">
                                <TextBlock Text="Дата:" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock x:Name="OpenCashDayDateText" Text="-" Foreground="#2C3E50"/>
                            </WrapPanel>
                            <UniformGrid Columns="6">
                                <Border BorderBrush="#D8E6DD" BorderThickness="1,1,0,1" Background="#FFFFFF" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="ДН" FontSize="11" Foreground="#607D6B" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="OpenCashOpeningDebitText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D8E6DD" BorderThickness="1,1,0,1" Background="#FFFFFF" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="КН" FontSize="11" Foreground="#607D6B" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="OpenCashOpeningCreditText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D8E6DD" BorderThickness="1,1,0,1" Background="#FFFFFF" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="Дт оборот" FontSize="11" Foreground="#607D6B" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="OpenCashDebitTurnoverText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D8E6DD" BorderThickness="1,1,0,1" Background="#FFFFFF" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="Кт оборот" FontSize="11" Foreground="#607D6B" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="OpenCashCreditTurnoverText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D8E6DD" BorderThickness="1,1,0,1" Background="#FFFFFF" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="ДК" FontSize="11" Foreground="#607D6B" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="OpenCashClosingDebitText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D8E6DD" BorderThickness="1" Background="#FFFFFF" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="КК" FontSize="11" Foreground="#607D6B" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="OpenCashClosingCreditText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="8,6" BorderBrush="#D5DEE8" BorderThickness="1" Background="#FFFFFF" CornerRadius="4">
                        <StackPanel>
                            <TextBlock x:Name="CashTurnoverHintText" Text="Общие остатки за период: выберите конкретную кассу" FontWeight="SemiBold" Foreground="#2C3E50" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,5">
                                <TextBlock Text="Период:" FontWeight="Bold" Margin="0,0,4,0"/>
                                <TextBlock x:Name="CashTurnoverDateText" Text="-" Foreground="#2C3E50"/>
                            </WrapPanel>
                            <UniformGrid Columns="6">
                                <Border BorderBrush="#D5DEE8" BorderThickness="1,1,0,1" Background="#FAFCFE" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="ДН" FontSize="11" Foreground="#607080" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CashOpeningDebitText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D5DEE8" BorderThickness="1,1,0,1" Background="#FAFCFE" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="КН" FontSize="11" Foreground="#607080" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CashOpeningCreditText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D5DEE8" BorderThickness="1,1,0,1" Background="#FAFCFE" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="Дт оборот" FontSize="11" Foreground="#607080" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CashDebitTurnoverText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D5DEE8" BorderThickness="1,1,0,1" Background="#FAFCFE" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="Кт оборот" FontSize="11" Foreground="#607080" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CashCreditTurnoverText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D5DEE8" BorderThickness="1,1,0,1" Background="#FAFCFE" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="ДК" FontSize="11" Foreground="#607080" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CashClosingDebitText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#D5DEE8" BorderThickness="1" Background="#FAFCFE" Padding="4,3">
                                    <StackPanel>
                                        <TextBlock Text="КК" FontSize="11" Foreground="#607080" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CashClosingCreditText" Text="0,00" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Margin="0,0,0,8" Padding="10,8" BorderBrush="#D5DEE8" BorderThickness="1" Background="#FFFFFF" CornerRadius="5">
                <WrapPanel>
                    <TextBlock Text="Документы:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold" Foreground="#2C3E50"/>
                    <Button x:Name="AddPaymentButton" Content="➖ Расходный КО" Width="130" Height="35" Margin="0,0,10,0"
                            Background="#E67E22" Foreground="White" Click="OnAddPaymentClick"/>
                    <Button x:Name="AddReceiptButton" Content="➕ Приходный КО" Width="130" Height="35" Margin="0,0,10,0"
                            Background="#27AE60" Foreground="White" Click="OnAddReceiptClick"/>
                    <Button x:Name="EditButton" Content="✏️ Редактировать" Width="120" Height="35" Margin="0,0,10,0"
                            Background="#3498DB" Foreground="White" IsEnabled="False" Click="OnEditClick"/>
                    <Button x:Name="DeleteButton" Content="🗑️ Удалить" Width="100" Height="35" Margin="0,0,10,0"
                            Background="#E74C3C" Foreground="White" IsEnabled="False" Click="OnDeleteClick"/>
                    <Button x:Name="PostButton" Content="✅ Провести" Width="100" Height="35" Margin="0,0,10,0"
                            Background="#9B59B6" Foreground="White" IsEnabled="False" Click="OnPostClick"/>
                    <Button x:Name="BatchPostButton" Content="✅ Провести выбранные" Width="165" Height="35" Margin="0,0,10,0"
                            Background="#8E44AD" Foreground="White" Click="OnBatchPostClick"
                            ToolTip="Провести все отмеченные непроведенные документы"/>
                    <Button x:Name="PrintButton" Content="🖨 Печатная форма" Width="145" Height="35" Margin="0,0,10,5"
                            Background="#34495E" Foreground="White" IsEnabled="False" Click="OnPrintClick"/>
                    <CheckBox x:Name="ChoosePrintFormCheckBox" Content="Выбрать форму" VerticalAlignment="Center" Margin="0,0,10,5"
                              ToolTip="Если выключено, сразу открывается активная форма по умолчанию. Если включено, можно выбрать вариант печатной формы."/>
                </WrapPanel>
            </Border>
            <Border Margin="0,0,0,8" Padding="10,8" BorderBrush="#D5DEE8" BorderThickness="1" Background="#FFF8EC" CornerRadius="5">
                <WrapPanel>
                    <TextBlock Text="Работа с кассовым днем:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="Дата:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="CashDayDatePicker" Width="120" ToolTip="Дата кассового дня для закрытия, открытия и оборотов за день"/>
                    <Button x:Name="CloseCashDayButton" Content="Закрыть день" Width="115" Height="32" Margin="10,0,8,0" Background="#D35400" Foreground="White" Click="OnCloseCashDayClick"/>
                    <Button x:Name="OpenCashDayButton" Content="Открыть день" Width="115" Height="32" Margin="0,0,8,0" Background="#27AE60" Foreground="White" Click="OnOpenCashDayClick"/>
                    <Button x:Name="DayTurnoversButton" Content="Обороты за день" Width="135" Height="32" Margin="0,0,8,0" Background="#2980B9" Foreground="White" Click="OnDayTurnoversClick"/>
                    <Button x:Name="ClosedDaysTurnoversButton" Content="Обороты по закрытым дням" Width="180" Height="32" Margin="0,0,8,0" Background="#2C3E50" Foreground="White" Click="OnClosedDaysTurnoversClick"/>
                </WrapPanel>
            </Border>
            <Border Padding="10,8" BorderBrush="#D5DEE8" BorderThickness="1" Background="#F8FBFE" CornerRadius="5">
                <WrapPanel>
                    <TextBlock Text="Отчеты по кассе:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold" Foreground="#2C3E50"/>
                    <Button x:Name="CashBookButton" Content="Кассовая книга" Width="125" Height="32" Margin="0,0,8,0" Background="#16A085" Foreground="White" Click="OnCashBookClick"/>
                    <Button x:Name="ReceiptExpenseRegisterButton" Content="Реестр приходов/расходов" Width="185" Height="32" Margin="0,0,8,0" Background="#34495E" Foreground="White" Click="OnReceiptExpenseRegisterClick"/>
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="DataGrid" Grid.Row="2" AutoGenerateColumns="False" 
          IsReadOnly="True" SelectionChanged="OnSelectionChanged"
          AlternatingRowBackground="#F5F5F5" BorderBrush="#BDC3C7" BorderThickness="1"
          MouseDoubleClick="DataGrid_MouseDoubleClick"
          LoadingRow="DataGrid_LoadingRow">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPostedDisplay}" Value="Да">
                            <Setter Property="Background" Value="LightGreen"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Выбор" Width="70" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelectedForBatchPost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanBatchPost}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="Отметить непроведенный документ для массового проведения"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="День" Binding="{Binding CashDayStatusDisplay}" Width="85">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#27AE60"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CashDayStatusDisplay}" Value="Не открыт">
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCashDayClosed}" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата" Binding="{Binding DocDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Тип КО" Binding="{Binding OrderTypeDisplay}" Width="120"/>
                <DataGridTextColumn Header="Документ" Binding="{Binding DocNumber}" Width="120"/>
                <DataGridTextColumn Header="Касса" Binding="{Binding CashDeskName}" Width="180"/>
                <DataGridTextColumn Header="Дебет" Binding="{Binding DebitAccount}" Width="120"/>
                <DataGridTextColumn Header="Кредит" Binding="{Binding CreditAccount}" Width="120"/>
                <DataGridTextColumn Header="Тип проводки" Binding="{Binding PostingTypeDisplay}" Width="250" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Сумма в сом" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="В валюте" Binding="{Binding AmountInCurrency, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Основание" Binding="{Binding Basis}" Width="180"/>
                <DataGridTextColumn Header="Проведён" Binding="{Binding IsPostedDisplay}" Width="80"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt}" Width="150"/>
                <DataGridTextColumn Header="Дата изменения" Binding="{Binding UpdatedAt}" Width="150"/>
            </DataGrid.Columns>
            
        </DataGrid>
        <!-- Детали выбранной проводки -->
        <GroupBox Grid.Row="3" Header="Дополнительная информация о проводке" Margin="0,8,0,0" Padding="6">
            <DataGrid x:Name="PostingDetailsGrid"
                      Height="95"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      AlternatingRowBackground="#F8F9FA"
                      BorderBrush="#BDC3C7"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Документ" Binding="{Binding [Документ]}" Width="100"/>
                    <DataGridTextColumn Header="Тип документа" Binding="{Binding [Тип документа]}" Width="150"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding [Дата]}" Width="90"/>
                    <DataGridTextColumn Header="Модуль" Binding="{Binding [Модуль]}" Width="100"/>
                    <DataGridTextColumn Header="Дебет" Binding="{Binding [Дебет]}" Width="95"/>
                    <DataGridTextColumn Header="Кредит" Binding="{Binding [Кредит]}" Width="95"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding [Сумма]}" Width="100"/>
                    <DataGridTextColumn x:Name="DetailAmountCurrencyColumn" Header="Сумма вал." Binding="{Binding [Сумма вал.]}" Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="DetailCurrencyColumn" Header="Валюта" Binding="{Binding [Валюта]}" Width="85" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="DetailOrganizationColumn" Header="Организация" Binding="{Binding [Организация]}" Width="180" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="DetailEmployeeColumn" Header="Сотрудник" Binding="{Binding [Сотрудник]}" Width="160" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="DetailMaterialColumn" Header="Материал" Binding="{Binding [Материал]}" Width="180" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding [Статус]}" Width="95"/>
                    <DataGridTextColumn Header="Примечание" Binding="{Binding [Примечание]}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <!-- Статус бар -->
        <StatusBar Grid.Row="4" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово" Foreground="Gray"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Подсказка: двойной щелчок по строке показывает реальную проводку документа." Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>


