<UserControl x:Class="BIS.ERP.Views.CatalogDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="DescriptionText" Foreground="#666" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="AddButton" Content="➕ Добавить"
                            MinWidth="108" Height="32" Margin="4,2"
                            Background="#27AE60" Foreground="White" Click="OnAddClick"/>
                    <Button x:Name="EditButton" Content="✏️ Редактировать"
                            MinWidth="112" Height="32" Margin="4,2"
                            Background="#3498DB" Foreground="White" Click="OnEditClick"
                            IsEnabled="False"/>
                    <Button x:Name="RefreshButton" Content="🔄 Обновить"
                            MinWidth="86" Height="32" Margin="4,2"
                            Background="#3498DB" Foreground="White" Click="OnRefreshClick"/>
                    <Button x:Name="DeleteButton" Content="🗑️ Удалить"
                            MinWidth="82" Height="32" Margin="4,2"
                            Background="#E74C3C" Foreground="White" Click="OnDeleteClick"
                            IsEnabled="False"/>
                    <Button x:Name="ExportButton" Content="📎 Экспорт"
                            MinWidth="82" Height="32" Margin="4,2"
                            Background="#9B59B6" Foreground="White" Click="OnExportClick"/>
                    <Button x:Name="ImportDbfButton" Content="📥 Загрузить DBF"
                            MinWidth="118" Height="32" Margin="4,2"
                            Background="#16A085" Foreground="White" Click="OnImportDbfClick"
                            Visibility="Collapsed"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Поиск по справочнику -->
        <Border x:Name="SearchPanel" Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="FixedAssetDatePanel" Grid.Column="0"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock Text="Показать на дату:" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="FixedAssetAsOfDatePicker"
                                Width="130" Height="32"
                                SelectedDateChanged="FixedAssetAsOfDatePicker_SelectedDateChanged"/>
                </StackPanel>

                <WrapPanel x:Name="CurrencyRateFilterPanel" Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock Text="Валюта:" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CurrencyRateFilterCombo"
                              Width="190" Height="32" MinWidth="170"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              SelectionChanged="CurrencyRateFilterCombo_SelectionChanged"
                              ToolTip="Показать историю курсов выбранной валюты"/>
                    <TextBlock Text="с:" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <DatePicker x:Name="CurrencyRatePeriodStartPicker"
                                Width="120" Height="32"
                                SelectedDateChanged="CurrencyRatePeriod_SelectedDateChanged"/>
                    <TextBlock Text="по:" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <DatePicker x:Name="CurrencyRatePeriodEndPicker"
                                Width="120" Height="32"
                                SelectedDateChanged="CurrencyRatePeriod_SelectedDateChanged"/>
                    <Button x:Name="CurrencyRateFindButton" Content="Найти"
                            MinWidth="72" Height="32" Margin="8,0,0,0"
                            Background="#3498DB" Foreground="White"
                            Click="CurrencyRateFindButton_Click"
                            ToolTip="Показать курсы за выбранный период"/>
                    <Button x:Name="UpdateNbkrRatesButton" Content="Обновить НБКР"
                            MinWidth="120" Height="32" Margin="8,0,0,0"
                            Background="#16A085" Foreground="White"
                            Click="OnUpdateNbkrRatesClick"
                            ToolTip="Загрузить историю курсов НБКР за выбранный период"/>
                    <Button x:Name="ActivateRateButton" Content="✅ Сделать активным"
                            MinWidth="150" Height="32" Margin="8,0,0,0"
                            Background="#27AE60" Foreground="White"
                            IsEnabled="False" Click="OnActivateRateClick"
                            ToolTip="Сделать выбранный курс активным для его валюты (остальные курсы этой валюты станут неактивными)"/>
                </WrapPanel>

                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Height="32" Padding="8,5"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Поиск по справочнику"/>

                <Button x:Name="SearchButton" Grid.Column="2" Content="🔍 Поиск"
                        MinWidth="88" Height="32" Margin="8,0,0,0"
                        Background="#3498DB" Foreground="White"
                        Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <!-- Таблица данных -->
        <DataGrid x:Name="DataGrid" Grid.Row="2" 
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#F8F9FA"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="0"
                  RowHeight="28"
                  ColumnHeaderHeight="42"
                  FontSize="12"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  LoadingRow="DataGrid_LoadingRow"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  SelectionChanged="DataGrid_SelectionChanged">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3498DB" Opacity="0.3"/>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridColumnHeaderStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="3,3"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>

        <!-- Дополнительные поля выбранной организации -->
        <Border x:Name="OrganizationDetailsPanel"
                Grid.Row="3"
                Background="#F8FBFE"
                BorderBrush="#D6E2EC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="Дополнительные поля организации"
                           Foreground="#2C3E50"
                           FontWeight="Bold"
                           FontSize="12"
                           Margin="0,0,0,8"/>
                <ItemsControl x:Name="OrganizationDetailsItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260"
                                    MinHeight="48"
                                    Background="White"
                                    BorderBrush="#D6E2EC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Field}"
                                               Foreground="#526B7A"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Value}"
                                               Foreground="#102A43"
                                               FontSize="12"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <!-- Статус бар -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Готово" Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressText" Text="" Foreground="#3498DB" FontSize="11" 
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

