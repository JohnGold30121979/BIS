<Window x:Class="BIS.ERP.Views.CatalogItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление записи"
        Height="600" Width="680" MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Border Background="White" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="DialogTitle" FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50" Margin="0,0,0,20"/>

            <!--
                Поля нельзя оборачивать внешним ScrollViewer: при отключённой
                горизонтальной прокрутке он отдаёт содержимому бесконечную ширину,
                и поля «растягиваются» — их ширину нельзя ни увидеть, ни изменить
                мышью. Скроллится только список полей по вертикали, а ширина панели
                привязана к ширине окна.
            -->
            <ScrollViewer x:Name="FieldsScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FieldsPanel" HorizontalAlignment="Stretch"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SaveButton" Content="Сохранить" Width="110" Height="36"
                        Margin="0,0,10,0" Background="#27AE60" Foreground="White" Click="OnSaveClick"/>
                <Button x:Name="CancelButton" Content="Отмена" Width="110" Height="36"
                        Click="OnCancelClick" Background="#95A5A6" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
