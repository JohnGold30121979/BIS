<UserControl x:Class="BIS.ERP.Views.FinanceDocumentWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1080">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="#1F3448"/>
            <TextBlock x:Name="DescriptionText" FontSize="12" Foreground="#667085"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="AddButton" Content="Добавить" Width="110" Height="34" Margin="0,0,8,0"
                    Background="#27AE60" Foreground="White" Click="OnAddClick"/>
            <Button x:Name="EditButton" Content="Редактировать" Width="125" Height="34" Margin="0,0,8,0"
                    Background="#3498DB" Foreground="White" IsEnabled="False" Click="OnEditClick"/>
            <Button x:Name="DeleteButton" Content="Удалить" Width="100" Height="34" Margin="0,0,8,0"
                    Background="#E74C3C" Foreground="White" IsEnabled="False" Click="OnDeleteClick"/>
            <Button x:Name="PostButton" Content="Провести" Width="105" Height="34" Margin="0,0,8,0"
                    Background="#8E44AD" Foreground="White" IsEnabled="False" Click="OnPostClick"/>
            <StackPanel x:Name="ReportPeriodPanel" Orientation="Horizontal" Margin="6,0,8,0" Visibility="Collapsed">
                <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker x:Name="ReportStartDatePicker" Width="120" Height="34" Margin="0,0,8,0"/>
                <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DatePicker x:Name="ReportEndDatePicker" Width="120" Height="34" Margin="0,0,8,0"/>
                <Button x:Name="ExportTurnoverExcelButton" Content="Оборотка Excel" Width="130" Height="34"
                        Background="#16A085" Foreground="White" Click="OnExportTurnoverExcelClick"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Content="Обновить" Width="105" Height="34"
                    Background="#95A5A6" Foreground="White" Click="OnRefreshClick"/>
        </StackPanel>

        <DataGrid x:Name="DataGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnGridDoubleClick"
                  AlternatingRowBackground="#F6F8FA"
                  BorderBrush="#D0D7DE"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding DocumentNumber}" Width="110"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DocumentDate, StringFormat=dd.MM.yyyy}" Width="105"/>
                <DataGridTextColumn x:Name="EmployeeColumn" Header="Сотрудник" Binding="{Binding EmployeeName}" Width="190"/>
                <DataGridTextColumn x:Name="AdvancePaymentColumn" Header="Вид расчета" Binding="{Binding AdvancePaymentName}" Width="210"/>
                <DataGridTextColumn x:Name="PeriodColumn" Header="Период" Binding="{Binding PeriodDisplay}" Width="170"/>
                <DataGridTextColumn x:Name="DebitAccountColumn" Header="Дебет" Binding="{Binding DebitAccountDisplay}" Width="160"/>
                <DataGridTextColumn x:Name="CreditAccountColumn" Header="Кредит" Binding="{Binding CreditAccountDisplay}" Width="160"/>
                <DataGridTextColumn x:Name="PaymentAccountColumn" Header="Счет выплаты" Binding="{Binding PaymentAccountDisplay}" Width="160"/>
                <DataGridTextColumn x:Name="AmountColumn" Header="Сумма" Binding="{Binding Amount}" Width="105"/>
                <DataGridTextColumn x:Name="PayableAmountColumn" Header="К выплате" Binding="{Binding PayableAmount}" Width="105"/>
                <DataGridTextColumn Header="Основание" Binding="{Binding Basis}" Width="220"/>
                <DataGridTextColumn x:Name="PostedColumn" Header="Проведен" Binding="{Binding IsPostedDisplay}" Width="90"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox x:Name="PostingDetailsPanel" Grid.Row="3" Header="Дополнительная информация о проводке" Padding="6" Margin="0,10,0,0" Visibility="Collapsed">
            <DataGrid x:Name="PostingDetailsGrid"
                      Height="96"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      AlternatingRowBackground="#F8F9FA"
                      BorderBrush="#BDC3C7"
                      BorderThickness="1"
                      MouseDoubleClick="PostingDetailsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Документ" Binding="{Binding [Документ]}" Width="90"/>
                    <DataGridTextColumn Header="Тип документа" Binding="{Binding [Тип документа]}" Width="135"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding [Дата]}" Width="90"/>
                    <DataGridTextColumn Header="Модуль" Binding="{Binding [Модуль]}" Width="95"/>
                    <DataGridTextColumn Header="Дебет" Binding="{Binding [Дебет]}" Width="95"/>
                    <DataGridTextColumn Header="Кредит" Binding="{Binding [Кредит]}" Width="95"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding [Сумма]}" Width="95"/>
                    <DataGridTextColumn x:Name="DetailAmountCurrencyColumn" Header="Сумма вал." Binding="{Binding [Сумма вал.]}" Width="95" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="DetailCurrencyColumn" Header="Валюта" Binding="{Binding [Валюта]}" Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="DetailOrganizationColumn" Header="Организация" Binding="{Binding [Организация]}" Width="160" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="DetailEmployeeColumn" Header="Сотрудник" Binding="{Binding [Сотрудник]}" Width="160" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding [Статус]}" Width="95"/>
                    <DataGridTextColumn Header="Примечание" Binding="{Binding [Примечание]}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StatusBar Grid.Row="4" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово" Foreground="#667085"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>

