<UserControl x:Class="BIS.ERP.Views.EsfExportWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1150">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Выгрузка ЭСФ" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="XML-выгрузка счет-фактур с выбором документов за период"
                       FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,6,5"/>
            <DatePicker x:Name="StartDatePicker" Width="135" Height="32" Margin="0,0,14,5"/>

            <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,6,5"/>
            <DatePicker x:Name="EndDatePicker" Width="135" Height="32" Margin="0,0,18,5"/>

            <CheckBox x:Name="AllRowsCheckBox" Content="Все" VerticalAlignment="Center"
                      Margin="0,0,18,5" Checked="OnAllRowsChanged" Unchecked="OnAllRowsChanged"/>
            <CheckBox x:Name="OnlyNotExportedCheckBox" Content="Только невыгруженные" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,18,5"/>
            <CheckBox x:Name="InvoicesSourceCheckBox" Content="Счет-фактуры" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,18,5" Checked="OnSourceChanged" Unchecked="OnSourceChanged"/>
            <CheckBox x:Name="PostingsSourceCheckBox" Content="Другие проводки"
                      VerticalAlignment="Center" Margin="0,0,18,5" Checked="OnSourceChanged" Unchecked="OnSourceChanged"
                      ToolTip="Можно включить в список для отбора. XML ЭСФ пока формируется только по счет-фактурам."/>

            <Button Content="Обновить" Width="105" Height="34" Margin="0,0,10,5"
                    Background="#95A5A6" Foreground="White" Click="OnRefreshClick"/>
            <Button Content="Выгрузить XML" Width="130" Height="34" Margin="0,0,0,5"
                    Background="#27AE60" Foreground="White" Click="OnExportClick"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="#F5F8FA" BorderBrush="#DDE7EE" BorderThickness="1"
                Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="SummaryText" Text="Загрузка..." Foreground="#34495E"/>
        </Border>

        <DataGrid x:Name="ExportGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Выгр." Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DocDate, StringFormat=dd.MM.yyyy}" IsReadOnly="True" Width="105"/>
                <DataGridTextColumn Header="Модуль" Binding="{Binding ModuleCode}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Документ" Binding="{Binding DocNumber}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=N2}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Статус ЭСФ" Binding="{Binding TaxStatusDisplay}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Номер ЭСФ" Binding="{Binding EsfNumber}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="Организация" Binding="{Binding OrganizationName}" IsReadOnly="True" Width="*" MinWidth="230"/>
                <DataGridTextColumn Header="Основание" Binding="{Binding Basis}" IsReadOnly="True" Width="220"/>
                <DataGridTextColumn Header="Источник" Binding="{Binding SourceName}" IsReadOnly="True" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="4" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>