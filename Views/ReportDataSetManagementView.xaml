<UserControl x:Class="BIS.ERP.Views.ReportDataSetManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="SQL-наборы данных для отчетов. Разрешены только SELECT/WITH; параметры: @PeriodStart, @PeriodEnd, @CashDeskId, @OrganizationId, @EmployeeId, @AccountCode."
                   TextWrapping="Wrap"
                   Foreground="#445"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D5DEE8" BorderThickness="1" Background="#F8FBFE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Наборы данных" FontWeight="Bold" Margin="10"/>
                    <DataGrid x:Name="DataSetsGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="OnDataSetSelectionChanged"
                              RowHeight="28"
                              HeadersVisibility="Column"
                              Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="120"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>

            <Border Grid.Column="2" BorderBrush="#D5DEE8" BorderThickness="1" Background="White">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Код:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox x:Name="CodeBox" Grid.Row="0" Grid.Column="1" Height="30" Margin="4"/>
                    <CheckBox x:Name="IsActiveCheck" Grid.Row="0" Grid.Column="2" Content="Активен" IsChecked="True" VerticalAlignment="Center" Margin="8,0"/>
                    <CheckBox x:Name="IsSystemCheck" Grid.Row="0" Grid.Column="3" Content="Системный" VerticalAlignment="Center" Margin="8,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Название:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" Margin="4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" VerticalAlignment="Top" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="52" Margin="4" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Header="SQL набора данных" Margin="0,8,0,8">
                        <TextBox x:Name="SqlTextBox"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Header="Поля результата">
                        <DataGrid x:Name="FieldsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="45"/>
                                <DataGridTextColumn Header="Поле SQL" Binding="{Binding DbColumnName}" Width="180"/>
                                <DataGridTextColumn Header="Отображение" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding FieldType}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#425466"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Новый" Width="90" Height="34" Margin="0,0,8,0" Background="#27AE60" Foreground="White" Click="OnNewClick"/>
                <Button Content="Сохранить" Width="110" Height="34" Margin="0,0,8,0" Background="#2F80C9" Foreground="White" Click="OnSaveClick"/>
                <Button Content="Обновить поля" Width="125" Height="34" Margin="0,0,8,0" Background="#34495E" Foreground="White" Click="OnRefreshFieldsClick"/>
                <Button Content="Тест" Width="90" Height="34" Margin="0,0,8,0" Background="#16A085" Foreground="White" Click="OnTestClick"/>
                <Button Content="Удалить" Width="90" Height="34" Background="#E74C3C" Foreground="White" Click="OnDeleteClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
