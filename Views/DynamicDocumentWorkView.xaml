<UserControl x:Class="BIS.ERP.Views.DynamicDocumentWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Content="➕ Добавить" Click="OnAddClick" 
                        Background="#4CAF50" Foreground="White" Padding="15,8" Margin="0,0,10,0"
                        Cursor="Hand" FontWeight="Bold"/>
                <Button x:Name="PostButton" Content="✅ Провести" Width="100" Height="35" Margin="0,0,10,0"
                        Background="#27AE60" Foreground="White" Click="OnPostClick"/>
                <Button x:Name="EditButton" Content="✏️ Редактировать" Click="OnEditClick" 
                        Background="#2196F3" Foreground="White" Padding="15,8" Margin="0,0,10,0"
                        Cursor="Hand"/>
                <Button x:Name="DeleteButton" Content="🗑️ Удалить" Click="OnDeleteClick" 
                        Background="#F44336" Foreground="White" Padding="15,8" Margin="0,0,10,0"
                        Cursor="Hand"/>
                <Button Content="🔄 Обновить" Click="OnRefreshClick" 
                        Background="#9B59B6" Foreground="White" Padding="15,8"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Таблица данных -->
        <DataGrid x:Name="DataGrid" Grid.Row="1"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#F8F9FA"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  RowHeight="35"
                  FontSize="13"
                  SelectionChanged="OnSelectionChanged">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3498DB" Opacity="0.3"/>
            </DataGrid.Resources>
        </DataGrid>

        <!-- Строки проводки выбранного документа: таблица, а не карточка — строк может быть много -->
        <GroupBox Grid.Row="2" Header="Строки проводки" Padding="8" Margin="0,10,0,0" Height="210">
            <DataGrid x:Name="PostingLinesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      RowHeight="26"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8F9FA"
                      Background="White"
                      BorderBrush="#E0E0E0"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding LineNumber}" Width="40"/>
                    <DataGridTextColumn Header="Код" Binding="{Binding MaterialCode}" Width="70"/>
                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                    <DataGridTextColumn Header="Ед." Binding="{Binding UnitName}" Width="55"/>
                    <DataGridTextColumn Header="Дебет" Binding="{Binding AccountCode}" Width="90"/>
                    <DataGridTextColumn Header="Участок" Binding="{Binding SiteText}" Width="140"/>
                    <DataGridTextColumn Header="%" Binding="{Binding VatRate}" Width="55"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="90"/>
                    <DataGridTextColumn Header="Без НДС" Binding="{Binding AmountWithoutTax}" Width="100"/>
                    <DataGridTextColumn Header="НДС" Binding="{Binding VatAmount}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Статус бар -->
        <StatusBar Grid.Row="3" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>