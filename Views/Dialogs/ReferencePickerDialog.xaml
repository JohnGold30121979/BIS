<Window x:Class="BIS.ERP.Views.Dialogs.ReferencePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор значения"
        Height="540" Width="560"
        MinHeight="360" MinWidth="440"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="HintText" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="Можно ввести часть названия или GUID для поиска."/>
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1" Height="30" Margin="0,10,0,8"
                 TextChanged="OnSearchTextChanged"
                 ToolTip="Поиск по названию или коду"/>

        <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="6" Padding="2">
            <ListBox x:Name="ItemsList"
                     MouseDoubleClick="OnItemDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="4,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SelectButton" Content="Выбрать" Width="130" Height="34" Margin="0,0,8,0"
                    Background="#27AE60" Foreground="White" Click="OnSelectClick" IsDefault="True"/>
            <Button Content="Отмена" Width="110" Height="34"
                    Background="#95A5A6" Foreground="White" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
