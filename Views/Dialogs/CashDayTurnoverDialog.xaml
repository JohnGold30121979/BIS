<Window x:Class="BIS.ERP.Views.Dialogs.CashDayTurnoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обороты за день"
        Height="280"
        Width="900"
        MinHeight="240"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="#102A43"/>
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="#34495E" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="TurnoversGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F8FB"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#D5DEE8"
                  VerticalGridLinesBrush="#D5DEE8"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="День" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="ДН" Binding="{Binding OpeningDebit, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="КН" Binding="{Binding OpeningCredit, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Дт оборот" Binding="{Binding DebitTurnover, StringFormat=N2}" Width="130"/>
                <DataGridTextColumn Header="Кт оборот" Binding="{Binding CreditTurnover, StringFormat=N2}" Width="130"/>
                <DataGridTextColumn Header="ДК" Binding="{Binding ClosingDebit, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="КК" Binding="{Binding ClosingCredit, StringFormat=N2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Закрыть"
                Width="110"
                Height="34"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Background="#3498DB"
                Foreground="White"
                Click="OnCloseClick"/>
    </Grid>
</Window>

