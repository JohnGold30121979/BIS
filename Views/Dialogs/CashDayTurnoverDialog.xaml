<Window x:Class="BIS.ERP.Views.Dialogs.CashDayTurnoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обороты за день"
        Height="390" Width="760"
        MinHeight="350" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        PreviewKeyDown="OnPreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="#102A43"/>
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="#52677A" TextWrapping="Wrap"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="-4">
            <Border Margin="4" Padding="12" CornerRadius="4" BorderBrush="#D5DEE8" BorderThickness="1" Background="#F7FAFC">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ДН · Остаток на начало, дебет" FontSize="12" Foreground="#52677A" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OpeningDebitText" Text="0,00" Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Foreground="#243B53"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="12" CornerRadius="4" BorderBrush="#D5DEE8" BorderThickness="1" Background="#F7FAFC">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="КН · Остаток на начало, кредит" FontSize="12" Foreground="#52677A" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OpeningCreditText" Text="0,00" Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Foreground="#243B53"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="12" CornerRadius="4" BorderBrush="#CFE5D5" BorderThickness="1" Background="#F3FBF5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Дт оборот" FontSize="12" Foreground="#3D7653" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DebitTurnoverText" Text="0,00" Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Foreground="#21633A"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="12" CornerRadius="4" BorderBrush="#F0D9C8" BorderThickness="1" Background="#FFF8F2">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Кт оборот" FontSize="12" Foreground="#96613B" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CreditTurnoverText" Text="0,00" Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Foreground="#8A4B20"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="12" CornerRadius="4" BorderBrush="#C9DDEA" BorderThickness="1" Background="#F1F8FC">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ДК · Остаток на конец, дебет" FontSize="12" Foreground="#416B84" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ClosingDebitText" Text="0,00" Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Foreground="#1C5878"/>
                </StackPanel>
            </Border>
            <Border Margin="4" Padding="12" CornerRadius="4" BorderBrush="#C9DDEA" BorderThickness="1" Background="#F1F8FC">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="КК · Остаток на конец, кредит" FontSize="12" Foreground="#416B84" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ClosingCreditText" Text="0,00" Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Foreground="#1C5878"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Button Grid.Row="2" Content="Закрыть" Width="110" Height="35"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#3498DB" Foreground="White" Click="OnCloseClick"/>
    </Grid>
</Window>


