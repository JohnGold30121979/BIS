<UserControl x:Class="BIS.ERP.Views.Dialogs.ChartOfAccountEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="420">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Код:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="CodeBox" Width="280"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Наименование:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Width="280"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Тип счета:" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeCombo" Width="200">
                <ComboBoxItem Content="Active"/>
                <ComboBoxItem Content="Passive"/>
                <ComboBoxItem Content="ActivePassive"/>
            </ComboBox>
            <CheckBox x:Name="ActiveCheck" Content="Активен" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="DescriptionText" TextWrapping="Wrap" Foreground="#666"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,8,0" Click="OkButton_Click" Background="#27AE60" Foreground="White"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="90" Click="CancelButton_Click" Background="#E74C3C" Foreground="White"/>
        </StackPanel>

    </Grid>
</UserControl>