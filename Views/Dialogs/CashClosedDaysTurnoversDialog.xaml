<Window x:Class="BIS.ERP.Views.Dialogs.CashClosedDaysTurnoversDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обороты по закрытым дням" Height="500" Width="760" MinHeight="360" MinWidth="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="#506070" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="TurnoversGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" AlternatingRowBackground="#F5F5F5"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  CanUserResizeColumns="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110" MinWidth="95"/>
                <DataGridTextColumn Header="Ост на нач" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="140" MinWidth="115"/>
                <DataGridTextColumn Header="Дт оборот" Binding="{Binding DebitTurnover, StringFormat=N2}" Width="140" MinWidth="115"/>
                <DataGridTextColumn Header="Кт оборот" Binding="{Binding CreditTurnover, StringFormat=N2}" Width="140" MinWidth="115"/>
                <DataGridTextColumn Header="Остаток на конец" Binding="{Binding ClosingBalance, StringFormat=N2}" Width="*" MinWidth="145"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Закрыть" Width="100" Height="35" Click="OnCloseClick"
                    Background="#3498DB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

