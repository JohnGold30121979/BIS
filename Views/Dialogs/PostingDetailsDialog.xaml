<Window x:Class="BIS.ERP.Views.PostingDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали проводки"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F7FB">
    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7E3EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#3498DB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7E3EF"
                BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                               Foreground="#243B53" />
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#64748B"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border x:Name="StatusBadge" DockPanel.Dock="Right" CornerRadius="12"
                        Padding="12,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Детали: две колонки секций + примечание на всю ширину -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" Padding="16">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="LeftPanel" Grid.Row="0" Grid.Column="0" />
                <StackPanel x:Name="RightPanel" Grid.Row="0" Grid.Column="2" />
                <StackPanel x:Name="NotePanel" Grid.Row="1" Grid.Column="0"
                            Grid.ColumnSpan="3" />
            </Grid>
        </ScrollViewer>

        <!-- Подвал -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D7E3EF"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="FooterStatusText" DockPanel.Dock="Left"
                           VerticalAlignment="Center" Foreground="#64748B"
                           Text="Просмотр проводки без изменений" />
                <Button DockPanel.Dock="Right" Content="Закрыть"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OnCloseClick" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
