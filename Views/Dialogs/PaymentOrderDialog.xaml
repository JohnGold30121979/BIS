<Window x:Class="BIS.ERP.Views.PaymentOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Платежное поручение" Height="462" Width="760"
        MinHeight="540" MinWidth="650" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="DialogTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Номер (строка 1) -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Номер:" VerticalAlignment="Center"/>
            <TextBox x:Name="NumberBox" Grid.Row="1" Grid.Column="1" Height="26" IsReadOnly="True" Background="LightGray" Margin="0,0,0,4"/>

            <!-- Дата (строка 2) -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата:" VerticalAlignment="Center"/>
            <DatePicker x:Name="DatePicker" Grid.Row="2" Grid.Column="1" Height="26" SelectedDateChanged="OnRateInputChanged" Margin="0,0,0,4"/>

            <!-- Тип (строка 3) -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип:" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeCombo" Grid.Row="3" Grid.Column="1" Height="26" Margin="0,0,0,4">
                <ComboBoxItem Content="Исходящее (оплата)" Tag="Outgoing"/>
                <ComboBoxItem Content="Входящее (поступление)" Tag="Incoming"/>
            </ComboBox>

            <!-- Организация (строка 4) -->
            <TextBlock x:Name="OrganizationLabel" Grid.Row="4" Grid.Column="0" Text="Организация:" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <ComboBox x:Name="OrganizationCombo" Grid.Row="4" Grid.Column="1" Height="26"
                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      Visibility="Collapsed" Margin="0,0,0,4"/>

            <!-- Сотрудник и Материал (строка 5) -->
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,4">
                <Grid x:Name="EmployeePanel" Visibility="Collapsed" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Сотрудник:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="EmployeeCombo" Grid.Column="1" Height="26"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                </Grid>
                <Grid x:Name="MaterialPanel" Visibility="Collapsed" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Материал:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MaterialCombo" Grid.Column="1" Height="26"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                </Grid>
            </StackPanel>

            <!-- Банк (строка 6) -->
            <TextBlock x:Name="BankLabel" Grid.Row="6" Grid.Column="0" Text="Банк:" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <ComboBox x:Name="BankCombo" Grid.Row="6" Grid.Column="1" Height="26"
                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      Visibility="Collapsed" Margin="0,0,0,4"/>

            <!-- Дебет (строка 7) -->
            <TextBlock x:Name="OurAccountLabel" Grid.Row="7" Grid.Column="0" Text="Дебет:" VerticalAlignment="Center"/>
            <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OurAccountBox" Grid.Column="0" Height="26" IsReadOnly="True" Background="LightGray"/>
                <Button Grid.Column="1" Content="?" Width="30" Height="26" Margin="4,0,0,0" Click="SelectOurAccount_Click"/>
            </Grid>

            <!-- Кредит (строка 8) -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Кредит:" VerticalAlignment="Center"/>
            <Grid Grid.Row="8" Grid.Column="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CorrAccountBox" Grid.Column="0" Height="26" IsReadOnly="True" Background="LightGray"/>
                <Button Grid.Column="1" Content="?" Width="30" Height="26" Margin="4,0,0,0" Click="SelectCorrAccount_Click"/>
            </Grid>

            <!-- Сумма (строка 9) -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Сумма:" VerticalAlignment="Center"/>
            <TextBox x:Name="AmountBox" Grid.Row="9" Grid.Column="1" Height="26" Text="0" Margin="0,0,0,4"/>

            <!-- Валюта (строка 10) -->
            <TextBlock x:Name="CurrencyLabel" Grid.Row="10" Grid.Column="0" Text="Валюта:" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <ComboBox x:Name="CurrencyCombo" Grid.Row="10" Grid.Column="1" Height="26"
                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      Visibility="Collapsed" Margin="0,0,0,4"
                      SelectionChanged="OnRateInputChanged"/>

            <!-- Сумма в валюте (строка 11) -->
            <TextBlock x:Name="AmountCurrencyLabel" Grid.Row="11" Grid.Column="0" Text="Сумма в валюте:" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <TextBox x:Name="AmountCurrencyBox" Grid.Row="11" Grid.Column="1" Height="26" Text="0"
                     Visibility="Collapsed" Margin="0,0,0,4"
                     TextChanged="OnCurrencyAmountChanged"/>

            <!-- Курс (строка 12) -->
            <TextBlock x:Name="ExchangeRateLabel" Grid.Row="12" Grid.Column="0" Text="Курс:" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <TextBox x:Name="ExchangeRateBox" Grid.Row="12" Grid.Column="1" Height="26" Text="0"
                     Visibility="Collapsed" Margin="0,0,0,4"
                     TextChanged="OnCurrencyAmountChanged"/>

            <!-- Классификация платежа (строка 13) -->
            <TextBlock Grid.Row="13" Grid.Column="0" Text="Классификация платежа:" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Grid Grid.Row="13" Grid.Column="1" Margin="0,0,0,4" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PaymentClassificationBox" Grid.Column="0" Height="26" IsReadOnly="True" Background="LightGray"/>
                <Button Grid.Column="1" Content="?" Width="30" Height="26" Margin="4,0,0,0" Click="SelectPaymentClassification_Click"/>
            </Grid>

            <!-- Назначение (строка 14) -->
            <TextBlock Grid.Row="14" Grid.Column="0" Text="Назначение:" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox x:Name="PurposeBox" Grid.Row="14" Grid.Column="1" Height="50" TextWrapping="Wrap" Margin="0,0,0,4"/>

            <!-- Примечание (строка 15) -->
            <CheckBox x:Name="ShowDescriptionCheckBox" Grid.Row="15" Grid.Column="1"
                      Content="Показать примечание" Margin="0,4,0,6"
                      Checked="OnShowDescriptionChanged" Unchecked="OnShowDescriptionChanged"/>
            <TextBlock x:Name="DescriptionLabel" Grid.Row="16" Grid.Column="0" Text="Примечание:" VerticalAlignment="Top" Margin="0,4,0,0"
                       Visibility="Collapsed"/>
            <TextBox x:Name="DescriptionBox" Grid.Row="16" Grid.Column="1" Height="50" TextWrapping="Wrap" Margin="0,0,0,4"
                     Visibility="Collapsed"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="17" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Сохранить" Width="100" Height="32" Margin="0,0,10,0" Click="OnSaveClick"
                        Background="#27AE60" Foreground="White"/>
                <Button Content="Отмена" Width="100" Height="32" Click="OnCancelClick"
                        Background="#95A5A6" Foreground="White"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
