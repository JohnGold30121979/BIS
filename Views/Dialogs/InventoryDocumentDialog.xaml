<Window x:Class="BIS.ERP.Views.Dialogs.InventoryDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ ТМЗ" Height="820" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="10">
                <WrapPanel x:Name="HeaderTopPanel" Orientation="Horizontal"/>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Поставщик — узкая колонка: каждый контрол в отдельной строке и растянут
                     на всю ширину карточки; налоги и оплата занимают две трети ширины. -->
                <GroupBox Header="Поставщик" Padding="8">
                    <StackPanel x:Name="SupplierPanel"/>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Налоги и оплата" Padding="8">
                    <StackPanel x:Name="TaxPanel"/>
                </GroupBox>
            </Grid>

            <!-- Валюта — как в счёте-фактуре: отдельный блок под «Поставщиком» и налогами,
                 на всю ширину; виден только для счёта с признаком «Связь с валютами». -->
            <Grid x:Name="CurrencyCard" Margin="0,10,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Валюта"/>
                    <ComboBox x:Name="CurrencyCombo" Height="28"
                              DisplayMemberPath="Display" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="Курс"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExchangeRateBox" Height="28" Padding="6,3,6,3"/>
                        <Button Grid.Column="1" Content="?" Width="28" Height="28" Margin="4,0,0,0"
                                Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="OnRequestExchangeRateClick"
                                ToolTip="Курс валюты на дату документа из справочника курсов"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,10,0">
                    <TextBlock Text="Сумма в валюте"/>
                    <TextBox x:Name="AmountCurrencyBox" Height="28" Padding="6,3,6,3"
                             IsReadOnly="True" Text="0,00"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="Текущий курс" Width="110" Height="28" Padding="0"
                            Click="OnCurrentRateClick"
                            ToolTip="Подставить последний известный курс валюты"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <DataGrid x:Name="LinesGrid" Grid.Row="1" Margin="0,10,0,0" MinHeight="120"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeight="26" GridLinesVisibility="Horizontal"
                  CellEditEnding="OnCellEditEnding" CanUserReorderColumns="True"
                  PreviewKeyDown="OnLinesGridPreviewKeyDown"
                  VerticalScrollBarVisibility="Auto">
            <!-- Строки без системной синей заливки: фон и текст — из темы,
                 выделенная ячейка показывает только акцентную рамку. -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppBodyTextBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppBodyTextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppBodyTextBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppBodyTextBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True"/>
                <DataGridTextColumn Header="Код" Binding="{Binding MaterialCode}" Width="70" IsReadOnly="True"/>
                <!-- Материал — как счёт в шапке: поле с ручным вводом и кнопкой «?»
                     (справочник материалов с поиском). -->
                <DataGridTemplateColumn x:Name="MaterialColumn" Header="Материал" Width="300"
                                        SortMemberPath="MaterialText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="22" Padding="2,0,2,0"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Background="Transparent"
                                         Text="{Binding MaterialText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Введите код или наименование материала; «?» — поиск по справочнику"
                                         LostFocus="OnMaterialTextLostFocus"/>
                                <Button Grid.Column="1" Content="?" Width="24" Height="22" Padding="0"
                                        Margin="2,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip="Выбрать материал из справочника"
                                        Tag="material"
                                        Click="OnPickMaterialClick"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ед." Binding="{Binding UnitName}" Width="60" IsReadOnly="True"/>
                <!-- Дебет — как счёт в шапке: поле ввода с кнопкой «?» (план счетов). -->
                <DataGridTemplateColumn x:Name="AccountColumn" Header="Дебет" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="22" Padding="2,0,2,0"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Background="Transparent"
                                         Text="{Binding AccountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Введите код счёта; «?» — выбор из плана счетов"
                                         LostFocus="OnAccountTextLostFocus"/>
                                <Button Grid.Column="1" Content="?" Width="24" Height="22" Padding="0"
                                        Margin="2,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip="Выбрать счёт из плана счетов"
                                        Tag="account"
                                        Click="OnPickAccountClick"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Участок — тоже поле с ручным вводом и кнопкой «?». -->
                <DataGridTemplateColumn x:Name="SiteColumn" Header="Участок" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="22" Padding="2,0,2,0"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Background="Transparent"
                                         Text="{Binding SiteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Введите наименование участка; «?» — выбор из справочника"
                                         LostFocus="OnSiteTextLostFocus"/>
                                <Button Grid.Column="1" Content="?" Width="24" Height="22" Padding="0"
                                        Margin="2,0,0,0"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip="Выбрать участок из справочника"
                                        Tag="site"
                                        Click="OnPickSiteClick"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="%" Binding="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Без НДС" Binding="{Binding AmountWithoutTax}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="НДС" Binding="{Binding VatAmount}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить строку" Width="130" Height="32" Margin="0,0,8,0" Click="OnAddLineClick"/>
                <Button Content="Удалить строку" Width="130" Height="32" Margin="0,0,8,0" Click="OnDeleteLineClick"/>
                <Button Content="Пересчет" Width="110" Height="32" Margin="0,0,8,0" Click="OnRecalculateClick"/>
            </StackPanel>

            <!-- Завершающие кнопки — как в счёте-фактуре, справа под таблицей. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Запись" Width="110" Height="32" Margin="0,0,8,0"
                        Click="OnSaveClick" Background="{DynamicResource AppAccentBrush}" Foreground="White"/>
                <Button Content="Отмена" Width="110" Height="32" Click="OnCancelClick"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8"
                Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Без налогов" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    <TextBlock x:Name="TotalWithoutTaxText" FontWeight="Bold" FontSize="15" Text="0,00"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="НДС" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    <TextBlock x:Name="TotalVatText" FontWeight="Bold" FontSize="15" Text="0,00"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Налог с продаж" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    <TextBlock x:Name="TotalSalesTaxText" FontWeight="Bold" FontSize="15" Text="0,00"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Итого" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    <TextBlock x:Name="TotalAmountText" FontWeight="Bold" FontSize="15" Text="0,00"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
