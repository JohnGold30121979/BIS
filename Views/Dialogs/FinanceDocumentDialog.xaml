<Window x:Class="BIS.ERP.Views.FinanceDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Финансовый документ"
        Height="820"
        Width="760"
        MinHeight="620"
        MinWidth="620"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14">
            <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="Bold" Foreground="#1F3448" Margin="0,0,0,12"/>

            <GroupBox Header="Основные реквизиты" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="NumberBox" Grid.Row="0" Grid.Column="1" Height="30" IsReadOnly="True" Background="#F2F4F7" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <DatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="1" Height="30" SelectedDateChanged="OnRateInputChanged" Margin="0,0,0,8"/>
                    <Grid x:Name="AdvancePaymentHeaderPanel" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Пара счетов:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="AdvancePaymentCombo" Grid.Column="1" Height="30"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                  SelectionChanged="AdvancePaymentCombo_SelectionChanged"/>
                    </Grid>

                    <Grid x:Name="FinanceEmployeePanel" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Сотрудник:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="FinanceEmployeeCombo" Grid.Column="1" Height="30"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                    </Grid>

                    <Grid x:Name="OrganizationPanel" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Организация:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="OrganizationCombo" Grid.Column="1" Height="30"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                    </Grid>

                    <Grid x:Name="CommonAmountPanel" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Сумма:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="AmountBox" Grid.Column="1" Height="30" Text="0"/>
                    </Grid>

                    <Grid x:Name="DebitAccountPanel" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Счет дебета:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="DebitAccountBox" Grid.Column="1" Height="30" IsReadOnly="True" Background="#F2F4F7"/>
                        <Button Grid.Column="2" Content="?" Width="34" Height="30" Margin="6,0,0,0" Click="SelectDebitAccount_Click"/>
                    </Grid>

                    <Grid x:Name="CreditAccountPanel" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Счет кредита:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="CreditAccountBox" Grid.Column="1" Height="30" IsReadOnly="True" Background="#F2F4F7"/>
                        <Button Grid.Column="2" Content="?" Width="34" Height="30" Margin="6,0,0,0" Click="SelectCreditAccount_Click"/>
                    </Grid>

                    <Grid Grid.Row="8" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Основание:" VerticalAlignment="Top" Margin="0,0,8,8"/>
                        <TextBox x:Name="BasisBox" Grid.Row="0" Grid.Column="1" Height="52" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowDescriptionCheckBox" Grid.Row="1" Grid.Column="0" Content="Примечание" VerticalAlignment="Top"
                                  Margin="0,4,8,0" Checked="ShowDescriptionCheckBox_Changed" Unchecked="ShowDescriptionCheckBox_Changed"/>
                        <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1" Height="52" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="AdvanceBalancesPanel" Header="Остатки по авансу" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Остаток прошлого аванса" Foreground="#667085"/>
                        <TextBlock x:Name="PreviousAdvanceBalanceText" Text="0,00" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Получено" Foreground="#667085"/>
                        <TextBlock x:Name="ReceivedAdvanceText" Text="0,00" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Сумма аванса" Foreground="#667085"/>
                        <TextBlock x:Name="AdvanceAmountText" Text="0,00" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Остаток аванса" Foreground="#667085"/>
                        <TextBlock x:Name="ClosingAdvanceBalanceText" Text="0,00" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox x:Name="AdvanceExpensePanel" Header="Строки затрат" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AdvanceExpenseGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Height="230" Margin="0,0,0,8"
                              Language="ru-RU"
                              CellEditEnding="AdvanceExpenseGrid_CellEditEnding"
                              CurrentCellChanged="AdvanceExpenseGrid_CurrentCellChanged"
                              SelectionChanged="AdvanceExpenseGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding RowNumber}" Width="42" IsReadOnly="True"/>
                            <DataGridTextColumn x:Name="AdvanceExpenseDateColumn" Header="Дата"
                                                Binding="{Binding LineDate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=dd.MM.yyyy}"
                                                Width="115"/>
                            <DataGridTextColumn Header="Детали проводки"
                                                Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                Width="*" MinWidth="260"/>
                            <DataGridTextColumn Header="Счет расхода" Binding="{Binding ExpenseAccountDisplay}" Width="190" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="?" Width="30" Height="24" Tag="{Binding}" Click="SelectExpenseAccount_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" Width="115"/>
                            <DataGridComboBoxColumn x:Name="AdvanceCurrencyColumn" Header="Валюта" Width="130"
                                                    DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                    SelectedValueBinding="{Binding CurrencyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Visibility="Collapsed"/>
                            <DataGridTextColumn x:Name="AdvanceAmountCurrencyColumn" Header="Сумма в валюте"
                                                Binding="{Binding AmountCurrency, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"
                                                Width="125" Visibility="Collapsed"/>
                            <DataGridTextColumn x:Name="AdvanceExchangeRateColumn" Header="Курс"
                                                Binding="{Binding ExchangeRate, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.####}"
                                                Width="95" Visibility="Collapsed"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="Добавить строку" Width="130" Height="30" Margin="0,0,8,0" Click="AddAdvanceExpenseLine_Click"/>
                            <Button Content="Удалить строку" Width="130" Height="30" Click="DeleteAdvanceExpenseLine_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="AdvanceExpenseTotalText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="Bold" Text="Итого: 0,00"/>
                    </DockPanel>
                </Grid>
            </GroupBox>
            <GroupBox x:Name="AdvanceReportPanel" Header="Авансовый отчет" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Сотрудник:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="AdvanceEmployeeCombo" Grid.Row="0" Grid.Column="1" Height="30"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Вид расчета:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="LegacyAdvancePaymentCombo" Grid.Row="1" Grid.Column="1" Height="30"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              SelectionChanged="AdvancePaymentCombo_SelectionChanged" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Период отчета:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <DatePicker x:Name="ReportStartDatePicker" Width="150" Height="30"/>
                        <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0"/>
                        <DatePicker x:Name="ReportEndDatePicker" Width="150" Height="30"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Документ выдачи:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="IssueDocumentBox" Width="220" Height="30"/>
                        <TextBlock Text="от" VerticalAlignment="Center" Margin="10,0"/>
                        <DatePicker x:Name="IssueDocumentDatePicker" Width="150" Height="30"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Принято к учету:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="AcceptedAmountBox" Grid.Row="4" Grid.Column="1" Height="30" Text="0" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock Text="Перерасход:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="OverrunAmountBox" Width="130" Height="30" Text="0" Margin="0,0,18,0"/>
                        <TextBlock Text="Остаток к возврату:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ReturnAmountBox" Width="130" Height="30" Text="0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
<GroupBox x:Name="PayrollStatementPanel" Header="Платежная ведомость" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Сотрудник:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="PayrollEmployeeCombo" Grid.Row="0" Grid.Column="1" Height="30"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Период:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <DatePicker x:Name="PeriodStartDatePicker" Width="150" Height="30"/>
                        <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0"/>
                        <DatePicker x:Name="PeriodEndDatePicker" Width="150" Height="30"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Счет выплаты:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PaymentAccountBox" Grid.Column="1" Height="30" IsReadOnly="True" Background="#F2F4F7"/>
                        <Button Grid.Column="2" Content="?" Width="34" Height="30" Margin="6,0,0,0" Click="SelectPaymentAccount_Click"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock Text="Начислено:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="AccruedAmountBox" Width="115" Height="30" Text="0" TextChanged="PayrollAmountBox_TextChanged" Margin="0,0,18,0"/>
                        <TextBlock Text="Удержано:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="WithheldAmountBox" Width="115" Height="30" Text="0" TextChanged="PayrollAmountBox_TextChanged" Margin="0,0,18,0"/>
                        <TextBlock Text="К выплате:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PayableAmountBox" Width="115" Height="30" Text="0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox x:Name="CurrencyPanel" Header="Валюта" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Валюта:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="CurrencyCombo" Grid.Row="0" Grid.Column="1" Height="30"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              SelectionChanged="OnRateInputChanged" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Сумма в валюте:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="AmountCurrencyBox" Width="130" Height="30" Text="0" TextChanged="CurrencyAmountBox_TextChanged" Margin="0,0,18,0"/>
                        <TextBlock Text="Курс:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ExchangeRateBox" Width="130" Height="30" Text="0" TextChanged="CurrencyAmountBox_TextChanged"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Сохранить" Width="120" Height="36" Margin="0,0,10,0" Click="OnSaveClick"
                        Background="#27AE60" Foreground="White"/>
                <Button Content="Отмена" Width="120" Height="36" Click="OnCancelClick"
                        Background="#95A5A6" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>




