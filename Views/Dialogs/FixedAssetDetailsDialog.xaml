<Window x:Class="BIS.ERP.Views.FixedAssetDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка основного средства"
        Width="900"
        Height="690"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F7FB"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#243B53" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,10,4" />
        </Style>
        <Style x:Key="CardBoxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#BCD0DF" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PickerBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CardBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="#EEF3F7" />
        </Style>
        <Style x:Key="PickerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Content" Value="?" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#AFC5D8" />
        </Style>
        <Style x:Key="RecalculateButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Content" Value="R" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#C2410C" />
            <Setter Property="Background" Value="#FFF7ED" />
            <Setter Property="BorderBrush" Value="#FDBA74" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7E3EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="16,14,16,10" CornerRadius="12" BorderBrush="#D7E3EF" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#E7F2FB" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeaderTitleText"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#12304A"
                           Text="Карточка основного средства" />
                <TextBlock x:Name="HeaderSubtitleText"
                           Grid.Row="1"
                           Margin="0,6,0,0"
                           Foreground="#526D82"
                           Text="Основные сведения" />
            </Grid>
        </Border>

        <TabControl x:Name="CardTabs" Grid.Row="1" Margin="16,0,16,10" Background="Transparent">
            <TabItem Header="Основные сведения">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionBorderStyle}" Margin="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Код" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="CodeBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource PickerBoxStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource CardBoxStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Инвент. №" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="InventoryNumberBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBoxStyle}" />
                            <CheckBox x:Name="UseCodeAsInventoryNumberCheckBox"
                                      Grid.Row="2"
                                      Grid.Column="3"
                                      Grid.ColumnSpan="2"
                                      Content="основной код для инв. №"
                                      VerticalAlignment="Center"
                                      Margin="0,4,0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Год выпуска" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="ManufactureYearBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource CardBoxStyle}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Вид ОС" Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" LastChildFill="True">
                                <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="AssetTypePick_Click" />
                                <TextBox x:Name="AssetTypeDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                            </DockPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Группа ОС" Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" LastChildFill="True">
                                <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="AssetGroupPick_Click" />
                                <TextBox x:Name="AssetGroupDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                            </DockPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Материальный счет" Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" LastChildFill="True">
                                <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="AssetAccountPick_Click" />
                                <TextBox x:Name="AssetAccountDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                            </DockPanel>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Счет износа" Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="4" LastChildFill="True">
                                <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="DepreciationAccountPick_Click" />
                                <TextBox x:Name="DepreciationAccountDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                            </DockPanel>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Категория ОС (подгруппа)" Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="4" LastChildFill="True">
                                <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="AssetSubgroupPick_Click" />
                                <TextBox x:Name="AssetSubgroupDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                            </DockPanel>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="КЛАСС" Style="{StaticResource FieldLabelStyle}" />
                            <Border Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="4" BorderBrush="#D7E3EF" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,3,0,3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="StationaryClassRadio" Content="Стационарный" GroupName="AssetClass" Margin="0,0,24,0" IsChecked="True" />
                                    <RadioButton x:Name="MobileClassRadio" Content="Подвижной" GroupName="AssetClass" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Износ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Дата" FontWeight="Bold" Foreground="#243B53" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Документ" FontWeight="Bold" Foreground="#243B53" HorizontalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Поступления ОС" Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker x:Name="AcquisitionDatePicker" Grid.Row="1" Grid.Column="1" />
                                <TextBox x:Name="AcquisitionDocumentBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBoxStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="Участок" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="1" Grid.Column="5" LastChildFill="True">
                                    <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="SitePick_Click" />
                                    <TextBox x:Name="SiteDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                                </DockPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="в эксплуатацию" Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker x:Name="CommissioningDatePicker" Grid.Row="2" Grid.Column="1" />
                                <TextBox x:Name="CommissioningDocumentBox" Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="МОЛ" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="2" Grid.Column="5" LastChildFill="True">
                                    <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="ResponsiblePersonPick_Click" />
                                    <TextBox x:Name="ResponsiblePersonDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                                </DockPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="начала начисления износа" Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker x:Name="DepreciationStartDatePicker" Grid.Row="3" Grid.Column="1" />
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="Группа для налог декл" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="3" Grid.Column="5" LastChildFill="True">
                                    <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="TaxGroupPick_Click" />
                                    <TextBox x:Name="TaxGroupDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                                </DockPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Срок полезного использования" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" LastChildFill="True">
                                    <Button Style="{StaticResource RecalculateButtonStyle}" DockPanel.Dock="Right" ToolTip="Пересчитать срок по норме или месячной сумме" Click="ResetUsefulLife_Click" />
                                    <TextBlock DockPanel.Dock="Right" Text="лет" Margin="6,4,0,4" VerticalAlignment="Center" />
                                    <TextBox x:Name="UsefulLifeMonthsBox" Style="{StaticResource CardBoxStyle}" />
                                </DockPanel>
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="Шифр" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="DepreciationCodeBox" Grid.Row="4" Grid.Column="5" Style="{StaticResource CardBoxStyle}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Счет списания затрат по амортизации" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5" LastChildFill="True">
                                    <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="ExpenseAccountPick_Click" />
                                    <TextBox x:Name="ExpenseAccountDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="по первоначальной стоимости" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="InitialCostBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Норма амортизации, %" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="0" Grid.Column="4" LastChildFill="True">
                                    <Button Style="{StaticResource RecalculateButtonStyle}" DockPanel.Dock="Right" ToolTip="Вернуть расчет нормы" Click="ResetDepreciationRate_Click" />
                                    <TextBox x:Name="DepreciationRateBox" Style="{StaticResource CardBoxStyle}" />
                                </DockPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="по ликвидационной стоимости" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SalvageValueBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBoxStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Сумма месячного износа ОС" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="1" Grid.Column="4" LastChildFill="True">
                                    <Button Style="{StaticResource RecalculateButtonStyle}" DockPanel.Dock="Right" ToolTip="Вернуть расчет месячного износа" Click="ResetMonthlyDepreciation_Click" />
                                    <TextBox x:Name="MonthlyDepreciationBox" Style="{StaticResource CardBoxStyle}" />
                                </DockPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Сумма накопленного износа" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="AccumulatedDepreciationBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Перерасчетная стоимость" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="CarryingAmountBox" Grid.Row="2" Grid.Column="4" Style="{StaticResource CardBoxStyle}" />
                            </Grid>
                        </Border>

                        <WrapPanel HorizontalAlignment="Right" Margin="0,2,0,0">
                            <Button Content="Начислено/Списано перв стоимости" MinWidth="190" Height="38" Margin="0,0,8,0" Click="DevelopmentButton_Click" />
                            <Button Content="Доначислено/Досписано износа" MinWidth="190" Height="38" Margin="0,0,8,0" Click="DevelopmentButton_Click" />
                            <Button Content="Периоды консервации" MinWidth="150" Height="38" Click="DevelopmentButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Характеристики">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Метод амортизации" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" LastChildFill="True">
                                    <Button Style="{StaticResource PickerButtonStyle}" DockPanel.Dock="Right" Click="DepreciationMethodPick_Click" />
                                    <TextBox x:Name="DepreciationMethodDisplayBox" Style="{StaticResource PickerBoxStyle}" />
                                </DockPanel>
                                <CheckBox x:Name="UseMileageDepreciationCheckBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Амортизация по пробегу" Margin="0,8,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Месячный пробег" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="MonthlyMileageBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource CardBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Ресурс пробега" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="MileageResourceBox" Grid.Row="2" Grid.Column="4" Style="{StaticResource CardBoxStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Описание" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="DescriptionBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource CardBoxStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D7E3EF" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#64748B" Text="Готово" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource ActionButtonStyle}" Background="#95A5A6" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Сохранить" Style="{StaticResource ActionButtonStyle}" Background="#27AE60" Click="SaveButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>