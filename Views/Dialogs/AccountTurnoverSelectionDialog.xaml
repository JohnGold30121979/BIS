<Window x:Class="BIS.ERP.Views.Dialogs.AccountTurnoverSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обороты по счету"
        Height="590" Width="980"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Обороты по счету" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock x:Name="PeriodText" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#F4F7FA" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Сторона:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                <ComboBox x:Name="SideComboBox" Grid.Column="1" Height="30" SelectionChanged="OnSelectionChanged">
                    <ComboBoxItem Content="Дебет+Кредит" Tag="Both" IsSelected="True"/>
                    <ComboBoxItem Content="Дебет" Tag="Debit"/>
                    <ComboBoxItem Content="Кредит" Tag="Credit"/>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="Счет:" VerticalAlignment="Center" FontWeight="Bold" Margin="16,0,8,0"/>
                <ComboBox x:Name="AccountComboBox" Grid.Column="3" Height="30"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code"
                          SelectionChanged="OnSelectionChanged"/>

                <TextBlock Grid.Column="4" Text="Поиск счета:" VerticalAlignment="Center" FontWeight="Bold" Margin="16,0,8,0"/>
                <TextBox x:Name="AccountSearchBox" Grid.Column="5" Height="30"
                         TextChanged="OnAccountSearchChanged"
                         ToolTip="Введите начало счета. Например: 14 рассчитает обороты по всем счетам, начинающимся на 14."/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">
            <Border Background="#ECF8F2" BorderBrush="#BFE8D2" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Количество проводок" Foreground="#557067"/>
                    <TextBlock x:Name="CountText" FontSize="18" FontWeight="Bold" Foreground="#1E7D4D"/>
                </StackPanel>
            </Border>
            <Border Background="#F3F7FF" BorderBrush="#CEDBF3" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Дт оборот" Foreground="#53677E"/>
                    <TextBlock x:Name="AmountText" FontSize="18" FontWeight="Bold" Foreground="#1E5C99"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF0F0" BorderBrush="#F0CACA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Кт оборот" Foreground="#7D5353"/>
                    <TextBlock x:Name="CreditAmountText" FontSize="18" FontWeight="Bold" Foreground="#A03434"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF7E8" BorderBrush="#F1D7A3" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Оборот в валюте" Foreground="#7E6840"/>
                    <TextBlock x:Name="CurrencyAmountText" FontSize="18" FontWeight="Bold" Foreground="#A66A00"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DataGrid x:Name="DetailsGrid" Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AlternatingRowBackground="#F8F9FA"
                  RowHeaderWidth="0"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="95"/>
                <DataGridTextColumn Header="Документ" Binding="{Binding DocumentNumber}" Width="115"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding DocumentType}" Width="170"/>
                <DataGridTextColumn Header="Модуль" Binding="{Binding ModuleName}" Width="120"/>
                <DataGridTextColumn Header="Дебет" Binding="{Binding DebitAccount}" Width="105"/>
                <DataGridTextColumn Header="Кредит" Binding="{Binding CreditAccount}" Width="105"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Сумма вал." Binding="{Binding AmountCurrency, StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*" MinWidth="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="Вид:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
            <ComboBox x:Name="ReportKindComboBox" Width="175" Height="34" SelectedIndex="0" Margin="0,0,8,0">
                <ComboBoxItem Content="Полная" Tag="Full"/>
                <ComboBoxItem Content="Краткая" Tag="Brief"/>
                <ComboBoxItem Content="Итоги по статьям" Tag="ByArticle"/>
                <ComboBoxItem Content="Итоги по субсчетам" Tag="BySubaccount"/>
            </ComboBox>
            <Button Content="Показать/печать Excel" Width="170" Height="34" Margin="0,0,8,0"
                    Background="#1E7D4D" Foreground="White" Click="OnOpenExcelClick"/>
            <Button Content="Закрыть" Width="110" Height="34" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>