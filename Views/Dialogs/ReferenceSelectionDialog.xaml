<Window x:Class="BIS.ERP.Views.ReferenceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор записи" Height="450" Width="660" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="260" Height="30" Padding="8,4"
                         TextChanged="SearchBox_TextChanged" ToolTip="Введите текст для поиска"/>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Content="Добавить" Width="105" Height="30" Margin="8,2,0,2"
                        Click="OnAddClick" ToolTip="Добавить новую запись в справочник"
                        Visibility="Collapsed" IsEnabled="False"/>
                <Button x:Name="EditButton" Content="Изменить" Width="105" Height="30" Margin="8,2,0,2"
                        Click="OnEditClick" ToolTip="Изменить выбранную запись справочника"
                        Visibility="Collapsed" IsEnabled="False"/>
                <Button x:Name="ExtraActionButton" Content="Действие" Width="125" Height="30" Margin="8,2,0,2"
                        Click="OnExtraActionClick" Visibility="Collapsed" IsEnabled="False"/>
                <Button x:Name="SelectButton" Content="Выбрать" Width="100" Height="30" Margin="8,2,0,2"
                        Click="OnSelectClick" IsDefault="True" IsEnabled="False"
                        Background="#27AE60" Foreground="White"/>
                <Button Content="Отмена" Width="100" Height="30" Margin="8,2,0,2" Click="OnCancelClick" IsCancel="True"
                        Background="#E74C3C" Foreground="White"/>
            </WrapPanel>
        </DockPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  AlternatingRowBackground="#F5F5F5"
                  SelectionChanged="ItemsGrid_SelectionChanged"
                  MouseDoubleClick="ItemsGrid_MouseDoubleClick"/>
    </Grid>
</Window>