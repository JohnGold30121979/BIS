<Window x:Class="BIS.ERP.Views.ReferenceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор записи" Height="560" Width="1100" MinWidth="840" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            Поиск в первой строке, кнопки управления — под ним во второй.
            Раньше всё стояло в одной строке: сумма фиксированных ширин (~933 px)
            не помещалась в окно, кнопки уходили за правый край и при растягивании
            окна мышью ничего не менялось. Поле поиска занимает звёздочную колонку
            и тянется вместе с окном.
        -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Height="30" MinWidth="160" Padding="8,4"
                     TextChanged="SearchBox_TextChanged" ToolTip="Введите текст для поиска"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
            <Button x:Name="AddButton" Content="Добавить" Width="105" Height="30" Margin="0,0,8,0"
                    Click="OnAddClick" ToolTip="Добавить новую запись в справочник"
                    Visibility="Collapsed" IsEnabled="False"/>
            <Button x:Name="EditButton" Content="Изменить" Width="105" Height="30" Margin="0,0,8,0"
                    Click="OnEditClick" ToolTip="Изменить выбранную запись справочника"
                    Visibility="Collapsed" IsEnabled="False"/>
            <Button x:Name="ExtraActionButton" Content="Действие" Width="125" Height="30" Margin="0,0,8,0"
                    Click="OnExtraActionClick" Visibility="Collapsed" IsEnabled="False"/>
            <Button x:Name="SelectButton" Content="Выбрать" Width="100" Height="30" Margin="0,0,8,0"
                    Click="OnSelectClick" IsDefault="True" IsEnabled="False"
                    Background="#27AE60" Foreground="White"/>
            <Button Content="Отмена" Width="100" Height="30" Click="OnCancelClick" IsCancel="True"
                    Background="#E74C3C" Foreground="White"/>
        </StackPanel>

        <DataGrid x:Name="ItemsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  AlternatingRowBackground="#F5F5F5"
                  CanUserResizeColumns="True" CanUserReorderColumns="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionChanged="ItemsGrid_SelectionChanged"
                  MouseDoubleClick="ItemsGrid_MouseDoubleClick"/>
    </Grid>
</Window>