<Window x:Class="BIS.ERP.Views.Dialogs.DocumentPostingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проводки документа" Height="Auto" Width="Auto"
        ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            <WrapPanel x:Name="TurnoverSummaryPanel" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <DataGrid x:Name="PostingsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" AlternatingRowBackground="#F5F5F5"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="95" MinWidth="85"/>
                <DataGridTextColumn Header="Дебет" Binding="{Binding DebitAccount}" Width="120" MinWidth="90"/>
                <DataGridTextColumn Header="Кредит" Binding="{Binding CreditAccount}" Width="120" MinWidth="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="105" MinWidth="85"/>
                <DataGridTextColumn Header="Содержание" Binding="{Binding Note}" Width="*" MinWidth="240"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,8,0,8" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть" Width="100" Height="35" Click="OnCloseClick"
                    Background="#3498DB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

