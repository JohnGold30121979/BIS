<Window x:Class="BIS.ERP.MainWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BIS.ERP.Converters"
        xmlns:controls="clr-namespace:BIS.ERP.Views.Controls"
        Title="BIS ERP - Рабочий режим"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowDrop="True"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - НАВИГАЦИЯ -->
        <Border Grid.Column="0" Background="{DynamicResource AppSidebarBackgroundBrush}">
            <DockPanel>
                <!-- Шапка -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource AppBrandHeaderBackgroundBrush}" Padding="15">
                    <StackPanel>
                        <!-- Верхняя часть с заголовком и кнопкой -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="7"
                                            Background="{DynamicResource AppAccentBrush}"
                                            Margin="0,0,8,0">
                                        <Grid>
                                            <Image x:Name="SystemLogoImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                            <TextBlock x:Name="SystemIconText" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppBrandIconForegroundBrush}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="SystemNameText" FontSize="22" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppBrandTitleForegroundBrush}"/>
                                </StackPanel>
                                <!-- Версия продукта видна всегда: по ней определяют, какая сборка запущена.
                                     Подробная версия с датой сборки — в диалоге «О системе». -->
                                <TextBlock x:Name="VersionText" FontSize="10" Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AppBrandSubtitleForegroundBrush}"/>
                            </StackPanel>

                            <!-- Кнопка смены темы -->
                            <Button Grid.Column="1" x:Name="ThemeToggleButton" 
                                    Content="🌙" FontSize="20" 
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource AppBrandTitleForegroundBrush}" Cursor="Hand"
                                    Click="OnThemeToggleClick"
                                    ToolTip="Сменить тему"/>
                        </Grid>

                        <!-- Информация об информационной базе -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border Width="22" Height="22" CornerRadius="6"
                                    Background="{DynamicResource AppAccentBrush}" Margin="0,0,7,0">
                                <Grid>
                                    <Image x:Name="InfoBaseLogoImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                    <TextBlock x:Name="InfoBaseIconText" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CurrentInfoBaseText" Text="Рабочий режим" 
                                       FontSize="11" Foreground="{DynamicResource AppBrandSubtitleForegroundBrush}" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource AppBrandSubtitleForegroundBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CurrentUserText" FontSize="11"
                                       Foreground="{DynamicResource AppBrandSubtitleForegroundBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="Текущий пользователь"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Быстрый поиск по дереву объектов -->
                <Border DockPanel.Dock="Top" Margin="12,4,12,8"
                        Background="{DynamicResource AppContentBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NavigationSearchBox"
                                 Height="30" Margin="10,0,0,0"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource AppNavigationForegroundBrush}"
                                 ToolTip="Быстрый поиск: Enter — следующее совпадение, Esc — очистить"
                                 TextChanged="OnNavigationSearchTextChanged"
                                 KeyDown="OnNavigationSearchKeyDown"/>
                        <TextBlock x:Name="NavigationSearchWatermark"
                                   Grid.Column="0" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="🔍 Поиск объекта..."
                                   Foreground="{DynamicResource AppNavigationMutedForegroundBrush}"/>
                        <Button x:Name="NavigationSearchClearButton"
                                Grid.Column="1" Width="24" Height="24" Margin="4,0,6,0"
                                VerticalAlignment="Center" Content="✕" FontSize="11"
                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource AppNavigationMutedForegroundBrush}"
                                Visibility="Collapsed"
                                ToolTip="Очистить поиск"
                                Click="OnNavigationSearchClearClick"/>
                    </Grid>
                </Border>

                <!-- Дерево навигации -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              Background="{DynamicResource AppSidebarBackgroundBrush}">
                    <TreeView x:Name="NavigationTree" 
                              Background="{DynamicResource AppSidebarBackgroundBrush}" 
                              BorderThickness="0"
                              AllowDrop="True"
                              DragOver="NavigationTree_DragOver"
                              Drop="NavigationTree_Drop"
                              PreviewMouseLeftButtonDown="NavigationTree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="NavigationTree_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="NavigationTree_PreviewMouseMove">
                        <TreeView.Resources>
                            <!-- Дефолтный шаблон TreeViewItem красит выделение не из Background,
                                 а из системных кистей: с фокусом — HighlightBrushKey, без фокуса —
                                 InactiveSelectionHighlightBrushKey. Переопределяем все четыре
                                 (фон и текст), чтобы выделенный узел читался одинаково —
                                 и когда фокус в дереве, и когда пользователь щёлкнул закладку
                                 и фокус ушёл в MDI. -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                             Color="{DynamicResource AppNavigationSelectionColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                             Color="{DynamicResource AppNavigationSelectionColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                             Color="{DynamicResource AppNavigationSelectionTextColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                             Color="{DynamicResource AppNavigationSelectionTextColor}"/>
                        </TreeView.Resources>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource AppNavigationForegroundBrush}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="5,8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Style.Triggers>
                                    <!-- Наведение — первым: выделение объявлено ниже и перекрывает
                                         его. Раньше было наоборот: курсор над узлом закрашивал
                                         выделение цветом наведения (#34495E = цвет панели),
                                         и выбранный узел было не видно. -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AppNavigationHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AppNavigationSelectionBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppNavigationSelectionTextBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Акцентная полоса выбранного узла. Место под неё
                                         занято всегда (Background=Transparent), чтобы
                                         текст не прыгал вправо при выделении. -->
                                    <Border x:Name="SelectionBar" Width="3" Height="16"
                                            Margin="0,0,7,0" CornerRadius="1.5"
                                            VerticalAlignment="Center"
                                            Background="Transparent"/>
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Badge}" FontSize="11" 
                                               Foreground="{DynamicResource AppNavigationMutedForegroundBrush}" 
                                               Margin="10,0,0,0" 
                                               Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}">
                                        <Setter TargetName="SelectionBar"
                                                Property="Background"
                                                Value="{DynamicResource AppNavigationSelectionAccentBrush}"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Сплиттер -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="#34495E" ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"/>

        <!-- Правая панель - контент -->
        <Border Grid.Column="2" Background="{DynamicResource AppContentBackgroundBrush}">
            <controls:MdiWorkspaceControl x:Name="ContentArea" Margin="20"/>
        </Border>
    </Grid>
</Window>
