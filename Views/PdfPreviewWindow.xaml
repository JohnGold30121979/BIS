<Window x:Class="BIS.ERP.Views.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Предпросмотр печатной формы"
        Height="760" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackgroundBrush}" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📄 " FontSize="16" Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                <TextBlock x:Name="TitleText"
                           Text="Предпросмотр печатной формы"
                           FontSize="16" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppPrimaryTextBrush}"/>
            </StackPanel>
        </Border>

        <!-- Просмотр PDF прямо в окне -->
        <Border Grid.Row="1" Margin="8"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Background="White">
            <Grid>
                <wv2:WebView2 x:Name="PdfView" Visibility="Collapsed"/>

                <!-- Показывается, пока документ готовится или если просмотр недоступен. -->
                <StackPanel x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="620">
                    <TextBlock Text="Формирование документа…"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#2C3E50"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="PreviewStatusText"
                               Text="Подготовка просмотра."
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#5D6D7E"
                               Margin="0,0,0,14"/>
                    <Button x:Name="FallbackOpenButton"
                            Content="Открыть во внешней программе"
                            Width="220" Height="34"
                            Background="#34495E" Foreground="White"
                            Visibility="Collapsed"
                            Click="OnOpenClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель кнопок -->
        <Border Grid.Row="2" Background="{DynamicResource AppHeaderBackgroundBrush}" Padding="10">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppPrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🖨 Печать" Width="110" Height="35" Margin="5"
                            Background="#3498DB" Foreground="White" Click="OnPrintClick"
                            Cursor="Hand" ToolTip="Открыть диалог печати"/>
                    <Button Content="💾 Сохранить PDF" Width="140" Height="35" Margin="5"
                            Background="#27AE60" Foreground="White" Click="OnSaveClick"
                            Cursor="Hand"/>
                    <Button Content="🌐 Внешняя программа" Width="180" Height="35" Margin="5"
                            Background="#7F8C8D" Foreground="White" Click="OnOpenClick"
                            Cursor="Hand" ToolTip="Открыть документ программой, назначенной для PDF"/>
                    <Button Content="❌ Закрыть" Width="110" Height="35" Margin="5"
                            Background="#E74C3C" Foreground="White" Click="OnCloseClick"
                            Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
